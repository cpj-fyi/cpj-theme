<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    {{> "fonts"}}
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    <link rel="stylesheet" href="{{asset "css/buy-page.css"}}">
    <link rel="stylesheet" href="{{asset "css/contact-form.css"}}">
    <link rel="stylesheet" href="{{asset "css/native-resources.css"}}">

    <link rel="stylesheet" href="{{asset "css/typography.css"}}">
    <link rel="stylesheet" href="{{asset "css/book-reader.css"}}">
    <link rel="stylesheet" href="{{asset "css/pattern-pulse.css"}}">

    {{!-- One owner for social metadata: multiple og:image tags can become a
         collage in Messages. Replace only Ghost's social tags when supplying
         generated artwork; retain canonical, JSON-LD, feeds and integrations. --}}
    {{#is "post,page"}}
        {{#post}}
            {{#if feature_image}}
                {{ghost_head}}
            {{else}}
                {{#if @custom.art_url}}
                    {{> "post-social-meta"}}
                    {{ghost_head exclude="social_data"}}
                {{else}}
                    {{ghost_head}}
                {{/if}}
            {{/if}}
        {{/post}}
    {{else}}
        {{ghost_head}}
    {{/is}}
</head>
<body class="{{body_class}}">
    <div class="site-wrapper">
        {{> "header"}}

        <main class="site-main">
            {{{body}}}
        </main>

        {{> "footer"}}
    </div>

    {{> "search-modal"}}

    <script src="{{asset "js/moonphase.js"}}"></script>
    <script src="{{asset "js/main.js"}}"></script>
    <script src="{{asset "js/buy-page.js"}}"></script>
    <script src="{{asset "js/native-resources.js"}}"></script>
    <script src="{{asset "js/book-reader.js"}}"></script>
    <script src="{{asset "js/pattern-pulse.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
