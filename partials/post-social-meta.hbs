{{!-- Only used for posts/pages without a feature image and with art_url set.
     Keep explicit per-channel overrides. Dimensions belong only to generated
     PNGs; an editor-selected image may have a different aspect ratio. --}}
<meta property="og:site_name" content="{{@site.title}}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{#if og_title}}{{og_title}}{{else}}{{#if meta_title}}{{this.meta_title}}{{else}}{{title}}{{/if}}{{/if}}">
<meta property="og:description" content="{{#if og_description}}{{og_description}}{{else}}{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{#if meta_description}}{{this.meta_description}}{{else}}{{#if excerpt}}{{excerpt words="50"}}{{else}}{{@site.description}}{{/if}}{{/if}}{{/if}}{{/if}}">
<meta property="og:url" content="{{#if canonical_url}}{{canonical_url}}{{else}}{{url absolute="true"}}{{/if}}">
{{#if og_image}}
    <meta property="og:image" content="{{img_url og_image absolute="true"}}">
{{else}}
    <meta property="og:image" content="{{@custom.art_url}}/{{slug}}.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
{{/if}}
{{#if published_at}}<meta property="article:published_time" content="{{date published_at format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}">{{/if}}
{{#if updated_at}}<meta property="article:modified_time" content="{{date updated_at format="YYYY-MM-DDTHH:mm:ss.SSSZ"}}">{{/if}}
{{#foreach tags visibility="public"}}
    <meta property="article:tag" content="{{name}}">
{{/foreach}}
{{#if @site.facebook}}{{#with @site}}<meta property="article:publisher" content="{{social_url type="facebook"}}">{{/with}}{{/if}}
{{#primary_author}}{{#if facebook}}<meta property="article:author" content="{{social_url type="facebook"}}">{{/if}}{{/primary_author}}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{#if twitter_title}}{{twitter_title}}{{else}}{{#if meta_title}}{{this.meta_title}}{{else}}{{title}}{{/if}}{{/if}}">
<meta name="twitter:description" content="{{#if twitter_description}}{{twitter_description}}{{else}}{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{#if meta_description}}{{this.meta_description}}{{else}}{{#if excerpt}}{{excerpt words="50"}}{{else}}{{@site.description}}{{/if}}{{/if}}{{/if}}{{/if}}">
<meta name="twitter:url" content="{{#if canonical_url}}{{canonical_url}}{{else}}{{url absolute="true"}}{{/if}}">
{{#if twitter_image}}
    <meta name="twitter:image" content="{{img_url twitter_image absolute="true"}}">
{{else}}
    <meta name="twitter:image" content="{{@custom.art_url}}/{{slug}}.png">
{{/if}}
{{#if primary_author}}
    <meta name="twitter:label1" content="Written by">
    <meta name="twitter:data1" content="{{primary_author.name}}">
    {{#if primary_author.twitter}}<meta name="twitter:creator" content="{{primary_author.twitter}}">{{/if}}
{{/if}}
{{#if tags}}
    <meta name="twitter:label2" content="Filed under">
    <meta name="twitter:data2" content="{{tags autolink="false" separator=", "}}">
{{/if}}
{{#if @site.twitter}}<meta name="twitter:site" content="{{@site.twitter}}">{{/if}}
