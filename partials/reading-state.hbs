{{!-- Reading state is available only to signed-in readers with access to this chapter. --}}
{{#if access}}
    {{#if @member}}
        {{#if @member.uuid}}
            <div class="chapter-reading-state" data-reading-state data-member-id="{{@member.uuid}}" data-chapter-url="{{url}}" hidden>
                <button class="chapter-reading-toggle" type="button" data-reading-toggle aria-pressed="false" aria-describedby="chapter-reading-status">
                    <span class="chapter-reading-toggle-icon" aria-hidden="true">✓</span>
                    <span data-reading-label>Mark as read</span>
                </button>
                <p class="chapter-reading-status" id="chapter-reading-status" data-reading-status role="status">Saved on this browser</p>
            </div>
        {{/if}}
    {{/if}}
{{/if}}
