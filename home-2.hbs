    </div>
  </section>

  {{!-- ============ AI stripe ============ --}}
  <section class="h2-section h2-stripe h2-stripe-ai">
    <div class="h2-container">
      {{#get "tags" filter="slug:ai" limit="1"}}
        {{#if tags}}
          {{#foreach tags}}
            <header class="h2-stripe-h">
              <div class="h2-stripe-h-left">
                <span class="h2-stripe-eyebrow" aria-hidden="true">Theme</span>
                <h2 class="h2-stripe-title">{{name}}</h2>
              </div>
              <a class="h2-stripe-see" href="{{url}}">See all <span aria-hidden="true">&rarr;</span></a>
            </header>
            {{#if description}}
              <p class="h2-stripe-dek">{{description}}</p>
            {{/if}}
          {{/foreach}}
        {{/if}}
      {{/get}}

      {{!-- Violin rule: dots = ALL posts in the category, regardless of essays/speaking filter --}}
      {{#get "posts" filter="tag:ai" limit="all" order="published_at asc"}}
        {{#if posts}}
          <div class="h2-violin" aria-label="Filing density">
            <svg class="h2-violin-svg" data-violin
                 data-posts='[{{#foreach posts}}"{{date format="YYYY-MM"}}"{{#unless @last}},{{/unless}}{{/foreach}}]'
                 aria-hidden="true"></svg>
            <span class="h2-violin-caption">
              <b>{{posts.length}}</b>&nbsp;posts &middot;
              {{#foreach posts limit="1"}}&rsquo;{{date format="YY"}}{{/foreach}}
              &mdash;
              {{#foreach posts}}{{#if @last}}&rsquo;{{date format="YY"}}{{/if}}{{/foreach}}
            </span>
          </div>
        {{/if}}
      {{/get}}

      {{#get "posts" filter="tag:ai+tag:[essays,speaking]" limit="3" include="tags"}}
        {{#if posts}}
          <div class="h2-stripe-grid">
            {{#foreach posts}}
              <article class="h2-stripe-card">
                <h3 class="h2-stripe-card-title"><a href="{{url}}">{{title}}</a></h3>
                <div class="ds-meta">
                  <time class="ds-meta-item">{{date format="MM DD YY"}}</time>
                  <span class="ds-meta-item ds-meta-comments" aria-label="Comments">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span class="ds-meta-comments-text">{{comment_count}}</span>
                </span>
                </div>
                <p class="h2-stripe-card-excerpt">{{excerpt words="35"}}</p>
              </article>
            {{/foreach}}
          </div>
        {{else}}
          <p class="h2-stripe-empty">No posts yet.</p>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{!-- ============ Org Design stripe ============ --}}
  <section class="h2-section h2-stripe h2-stripe-orgdesign">
    <div class="h2-container">
      {{#get "tags" filter="slug:org-design" limit="1"}}
        {{#if tags}}
          {{#foreach tags}}
            <header class="h2-stripe-h">
              <div class="h2-stripe-h-left">
                <span class="h2-stripe-eyebrow" aria-hidden="true">Theme</span>
                <h2 class="h2-stripe-title">{{name}}</h2>
              </div>
              <a class="h2-stripe-see" href="{{url}}">See all <span aria-hidden="true">&rarr;</span></a>
            </header>
            {{#if description}}
              <p class="h2-stripe-dek">{{description}}</p>
            {{/if}}
          {{/foreach}}
        {{/if}}
      {{/get}}

      {{!-- Violin rule: dots = ALL posts in the category, regardless of essays/speaking filter --}}
      {{#get "posts" filter="tag:org-design" limit="all" order="published_at asc"}}
        {{#if posts}}
          <div class="h2-violin" aria-label="Filing density">
            <svg class="h2-violin-svg" data-violin
                 data-posts='[{{#foreach posts}}"{{date format="YYYY-MM"}}"{{#unless @last}},{{/unless}}{{/foreach}}]'
                 aria-hidden="true"></svg>
            <span class="h2-violin-caption">
              <b>{{posts.length}}</b>&nbsp;posts &middot;
              {{#foreach posts limit="1"}}&rsquo;{{date format="YY"}}{{/foreach}}
