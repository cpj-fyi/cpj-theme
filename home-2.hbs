{{!--
    Alternative homepage at /new/
    See docs/superpowers/specs/2026-05-21-homepage-redesign-design.md
--}}
{{!< default}}

<link rel="stylesheet" type="text/css" href="{{asset "css/home-2.css"}}">

<main class="h2-page">

  {{!-- ============ Masthead strip ============ --}}
  <aside class="h2-masthead">
    <hr class="h2-rule">
    <div class="h2-container h2-masthead-inner">
      <p class="h2-flag h2-masthead-flag">The Front Page</p>
      <p class="h2-masthead-date">{{date format="dddd · DD MMMM YYYY"}}</p>
      <p class="h2-masthead-filed">
        <span class="h2-masthead-filed-label">Filed under:</span>
        {{#get "posts" filter="tag:essays" limit="1" include="tags"}}
          {{#foreach posts}}
            {{#foreach tags}}
              {{#match slug "essays"}}{{else match slug "radar"}}{{else match slug "five-things"}}{{else match slug "hidden-patterns"}}
              {{else}}
                <span class="h2-masthead-tag">{{name}}</span>
              {{/match}}
            {{/foreach}}
          {{/foreach}}
        {{/get}}
      </p>
    </div>
    <hr class="h2-rule">
  </aside>

  {{!-- ============ Lead story ============ --}}
  <section class="h2-section h2-lead-section">
    <div class="h2-container">
      {{#get "posts" filter="tag:essays" limit="1" include="tags"}}
        {{#if posts}}
          {{#foreach posts}}
            <article class="h2-lead">
              <p class="h2-flag h2-lead-flag">Lead Essay</p>
              <h1 class="h2-lead-title">
                <a href="{{url}}">{{title}}</a>
              </h1>
              {{#if custom_excerpt}}
                <p class="h2-lead-deck">{{custom_excerpt}}</p>
              {{else}}
                <p class="h2-lead-deck">{{excerpt words="40"}}</p>
              {{/if}}
              <p class="h2-lead-byline">
                <span>By {{primary_author.name}}</span>
                <span aria-hidden="true">·</span>
                <span>{{reading_time}}</span>
                <span aria-hidden="true">·</span>
                <span>{{date format="DD MMM YY"}}</span>
              </p>
              <figure class="h2-lead-hero">
                <img src="{{#if feature_image}}{{feature_image}}{{else}}{{@custom.art_url}}/{{slug}}.svg{{/if}}"
                     alt=""
                     loading="eager"
                     width="1200"
                     height="630">
              </figure>
              <div class="h2-lead-lede">
                {{content words="150"}}
              </div>
              <p class="h2-lead-continue">
                <a href="{{url}}">Continue reading →</a>
              </p>
            </article>
          {{/foreach}}
        {{else}}
          <p class="h2-lead-empty">No essays yet — back soon.</p>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{!-- ============ Subscribe bar ============ --}}
  <section class="h2-sub" data-mode="portal">
    <hr class="h2-rule">
    <div class="h2-container h2-sub-inner">
      <div class="h2-sub-pitch">
        <h2 class="h2-sub-heading">Subscribe.</h2>
        <p class="h2-sub-tagline">Pick what arrives.</p>
      </div>
      <div class="h2-sub-form">
        <a href="#/portal/signup" class="h2-sub-row" data-portal="signup" aria-label="Open signup">
          <span class="h2-sub-input-mock" aria-hidden="true">your@email.com</span>
          <span class="h2-sub-submit" aria-hidden="true">Subscribe →</span>
        </a>
        <ul class="h2-sub-options" aria-hidden="true">
          <li class="h2-sub-option is-checked">
            <span class="h2-sub-check"></span>
            <span class="h2-sub-label"><strong>Essays</strong> — Long-form pieces, every few weeks.</span>
          </li>
          <li class="h2-sub-option is-checked">
            <span class="h2-sub-check"></span>
            <span class="h2-sub-label"><strong>Five Things</strong> — Short list-format posts.</span>
          </li>
          <li class="h2-sub-option is-checked">
            <span class="h2-sub-check"></span>
            <span class="h2-sub-label"><strong>Radar</strong> — Daily-ish observations on org design.</span>
          </li>
        </ul>
      </div>
    </div>
    <hr class="h2-rule">
  </section>

  {{!-- ============ Three-up index ============ --}}
  <section class="h2-section h2-index-section">
    <div class="h2-container h2-index">

      {{!-- Column 1: Essays --}}
      <div class="h2-index-col">
        <header class="h2-index-head">
          <h2 class="h2-flag h2-index-flag">Essays</h2>
          <a class="h2-index-seeall" href="/essays/">see all →</a>
        </header>
        {{#get "posts" filter="tag:essays" limit="7"}}
          {{#if posts}}
            <ol class="h2-index-list">
              {{#foreach posts from="2"}}
                <li class="h2-index-item">
                  <h3 class="h2-index-title"><a href="{{url}}">{{title}}</a></h3>
                  <div class="ds-meta h2-index-meta">
                    <span class="ds-meta-item">{{date format="DD MMM YY"}}</span>
                    {{#foreach tags}}
                      {{#match slug "essays"}}{{else match slug "radar"}}{{else match slug "five-things"}}{{else match slug "hidden-patterns"}}
                      {{else}}
                        <a href="{{url}}" class="ds-meta-item topical-tag-pill">{{name}}</a>
                      {{/match}}
                    {{/foreach}}
                  </div>
                </li>
              {{/foreach}}
            </ol>
          {{/if}}
        {{/get}}
      </div>

      {{!-- Column 2: Five Things --}}
      <div class="h2-index-col">
        <header class="h2-index-head">
          <h2 class="h2-flag h2-index-flag">Five Things</h2>
          <a class="h2-index-seeall" href="/five-things/">see all →</a>
        </header>
        {{#get "posts" filter="tag:five-things" limit="5"}}
          {{#if posts}}
            <ol class="h2-index-list">
              {{#foreach posts}}
                <li class="h2-index-item">
                  <h3 class="h2-index-title"><a href="{{url}}">{{title}}</a></h3>
                  <div class="ds-meta h2-index-meta">
                    <span class="ds-meta-item">{{date format="DD MMM YY"}}</span>
                  </div>
                </li>
              {{/foreach}}
            </ol>
          {{else}}
            <p class="h2-index-empty">Coming back soon.</p>
          {{/if}}
        {{/get}}
      </div>

      {{!-- Column 3: Index (static) --}}
      <div class="h2-index-col">
        <header class="h2-index-head">
          <h2 class="h2-flag h2-index-flag">Index</h2>
        </header>
        <ul class="h2-index-list h2-index-list-static">
          <li class="h2-index-item"><a class="h2-index-title" href="/colophon/">About Clay</a></li>
          <li class="h2-index-item"><a class="h2-index-title" href="/speaking/">Speaking</a></li>
          <li class="h2-index-item"><a class="h2-index-title" href="/talks/">Talks</a></li>
          <li class="h2-index-item"><a class="h2-index-title" href="/buy/">Hidden Patterns</a></li>
          <li class="h2-index-item"><a class="h2-index-title" href="/contact/">Contact</a></li>
        </ul>
      </div>

    </div>
  </section>

  {{!-- ============ Radar strip ============ --}}
  <section class="h2-radar">
    <div class="h2-radar-inner">
      <header class="h2-radar-head">
        <span class="radar-dot"></span>
        <h2 class="h2-flag h2-radar-flag">Radar</h2>
        <p class="h2-radar-tagline">Daily-ish observations on org design.</p>
        <a class="h2-radar-link" href="/radar/">View all →</a>
      </header>
      {{#get "posts" filter="tag:radar" limit="6" include="tags"}}
        {{#if posts}}
          <div class="h2-radar-track">
            {{#foreach posts}}
              <article class="h2-radar-card">
                <time class="h2-radar-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YY"}}</time>
                <h3 class="h2-radar-title"><a href="{{url}}">{{title}}</a></h3>
                <p class="h2-radar-excerpt">{{excerpt words="20"}}</p>
              </article>
            {{/foreach}}
          </div>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{!-- More modules will go here in subsequent tasks --}}

</main>
