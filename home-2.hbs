  {{!-- ============ Violin beeswarm renderer ============ --}}
  <script>
    (function () {
      const SVG_NS = 'http://www.w3.org/2000/svg';
      const dotR = 3;
      const yStep = 7;
      const H = 18;
      const cy = H / 2;
      const xClear = 14;

      function monthIndex(ym) {
        // ym is "YYYY-MM"
        const [y, m] = ym.split('-').map(n => parseInt(n, 10));
        return y * 12 + (m - 1);
      }

      function renderOne(svg) {
        let posts;
        try {
          posts = JSON.parse(svg.getAttribute('data-posts') || '[]');
        } catch (e) {
          posts = [];
        }
        if (!posts.length) return;

        const months = posts.map(monthIndex);
        const xMin = Math.min.apply(null, months);
        const xMax = Math.max.apply(null, months);
        const range = Math.max(1, xMax - xMin);

        while (svg.firstChild) svg.removeChild(svg.firstChild);
        const W = svg.clientWidth || svg.getBoundingClientRect().width || 800;
        svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
        svg.setAttribute('preserveAspectRatio', 'none');

        // hairline centerline
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('x2', W);
        line.setAttribute('y1', cy);
        line.setAttribute('y2', cy);
        line.setAttribute('stroke', '#1A1A1A');
        line.setAttribute('stroke-opacity', '0.18');
        line.setAttribute('stroke-width', '1');
        svg.appendChild(line);

        const slots = [0, -1, 1, -2, 2, -3, 3, -4, 4].map(k => cy + k * yStep);
        const placed = [];
        const sorted = months.slice().sort((a, b) => a - b);

        for (let i = 0; i < sorted.length; i++) {
          const m = sorted[i];
          const x = ((m - xMin) / range) * W;
          const neighbours = placed.filter(p => Math.abs(p.x - x) < xClear);
          const used = new Set(neighbours.map(p => p.y));
          let y = slots.find(s => !used.has(s));
          if (y === undefined) y = cy;
          placed.push({ x: x, y: y, last: i === sorted.length - 1 });
        }

        for (let i = 0; i < placed.length; i++) {
          const p = placed[i];
          const c = document.createElementNS(SVG_NS, 'circle');
          c.setAttribute('cx', p.x.toFixed(2));
          c.setAttribute('cy', p.y.toFixed(2));
          c.setAttribute('r', dotR);
          if (p.last) {
            c.setAttribute('fill', '#FF3252');
          } else {
            c.setAttribute('fill', '#1A1A1A');
            c.setAttribute('fill-opacity', '0.45');
          }
          svg.appendChild(c);
        }
      }

      function renderAll() {
        document.querySelectorAll('[data-violin]').forEach(renderOne);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderAll);
      } else {
        renderAll();
      }
      let resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderAll, 80);
      });
    })();
  </script>

