{{!--
    Alternative homepage at /new/
    See docs/superpowers/specs/2026-05-21-homepage-redesign-design.md
--}}
{{!< default}}

<link rel="stylesheet" type="text/css" href="{{asset "css/home-2.css"}}">

<main class="h2-page">

  <hr class="h2-rule h2-rule-fullbleed">

  {{!-- ============ Pub masthead (centered) ============ --}}
  <header class="h2-pubmast">
    <div class="h2-container">
      <h1 class="h2-pubmast-title">Clay Parker Jones</h1>
      {{#if @site.description}}
        <p class="h2-pubmast-subhead">{{@site.description}}</p>
      {{/if}}
    </div>
  </header>

  <hr class="h2-rule h2-rule-fullbleed">

  {{!-- ============ Top main: 3-column (Radar rail · Lead · Secondary) ============ --}}
  <section class="h2-section h2-topmain-section">
    <div class="h2-container h2-topmain">

      {{!-- Left rail: Radar --}}
      <aside class="h2-rail h2-rail-radar">
        <header class="h2-rail-head">
          <h2 class="h2-flag h2-rail-flag">Radar</h2>
        </header>
        {{#get "posts" filter="tag:radar" limit="5" include="tags"}}
          {{#if posts}}
            <ol class="h2-rail-list">
              {{#foreach posts}}
                <li class="h2-rail-item">
                  <time class="h2-rail-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM"}}</time>
                  <h3 class="h2-rail-title"><a href="{{url}}">{{title}}</a></h3>
                </li>
              {{/foreach}}
            </ol>
            <a class="h2-rail-more" href="/radar/">More on Radar →</a>
          {{/if}}
        {{/get}}
      </aside>

      {{!-- Center: Lead story (latest essay) --}}
      <article class="h2-lead">
        {{#get "posts" filter="tag:essays" limit="1" include="tags"}}
          {{#if posts}}
            {{#foreach posts}}
              <p class="h2-flag h2-lead-flag">Lead Essay</p>
              <h2 class="h2-lead-title">
                <a href="{{url}}">{{title}}</a>
              </h2>
              <div class="ds-meta">
                <time class="ds-meta-item">{{date format="MM DD YY"}}</time>
                <span class="ds-meta-item ds-meta-comments" aria-label="Comments">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span class="ds-meta-comments-text">{{comment_count}}</span>
                </span>
                {{#foreach tags}}
                  {{#match slug "essays"}}{{else match slug "radar"}}{{else match slug "five-things"}}{{else match slug "hidden-patterns"}}
                  {{else}}
                    <a href="{{url}}" class="ds-meta-item topical-tag-pill">{{name}}</a>
                  {{/match}}
                {{/foreach}}
              </div>
              <div class="h2-lead-lede-wrap">
                <div class="h2-lead-lede">
                  {{content words="220"}}
                </div>
                <div class="h2-lead-lede-fade" aria-hidden="true"></div>
                <a class="h2-lead-continue-btn" href="{{url}}">Continue reading &rarr;</a>
              </div>
            {{/foreach}}
          {{else}}
            <p class="h2-lead-empty">No essays yet — back soon.</p>
          {{/if}}
        {{/get}}
      </article>

      {{!-- Right: Story 2 (second-most-recent essay) --}}
      <article class="h2-story2">
        {{#get "posts" filter="tag:essays" limit="2" include="tags"}}
          {{#if posts}}
            {{#foreach posts from="2"}}
              <p class="h2-flag h2-story2-flag">Also Reading</p>
              <h3 class="h2-story2-title">
                <a href="{{url}}">{{title}}</a>
              </h3>
              {{#if custom_excerpt}}
                <p class="h2-story2-deck">{{custom_excerpt}}</p>
              {{else}}
                <p class="h2-story2-deck">{{excerpt words="35"}}</p>
              {{/if}}
              <p class="h2-story2-byline">
                <span>{{reading_time}}</span>
                <span aria-hidden="true">·</span>
                <span>{{date format="DD MMM YY"}}</span>
              </p>
              <p class="h2-story2-continue">
                <a href="{{url}}">Continue reading →</a>
              </p>
              <hr class="h2-rule h2-story2-rule">
            {{/foreach}}
          {{/if}}
        {{/get}}
        <div class="h2-story2-bio">
          <ul class="h2-story2-social" aria-label="Social accounts">
            {{#if @site.twitter}}
              <li>
                <a href="https://twitter.com/{{@site.twitter}}" aria-label="X (Twitter)" rel="me noopener" target="_blank">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
              </li>
            {{/if}}
            {{#if @site.facebook}}
              <li>
                <a href="https://www.facebook.com/{{@site.facebook}}" aria-label="Facebook" rel="me noopener" target="_blank">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                  </svg>
                </a>
              </li>
            {{/if}}
          </ul>
          <p class="h2-story2-bio-text">
            cpj.fyi is the site of me, Clay Parker Jones. I am Senior Director of Org Design &amp; Development at Airbnb, and author of <em>Hidden Patterns</em>. The archives here stretch back to 2006.
          </p>
          <a class="h2-story2-subscribe" href="#/portal/signup" data-portal="signup">Subscribe &rarr;</a>
        </div>
      </article>

    </div>
  </section>

  {{!-- ============ AI stripe ============ --}}
  <section class="h2-section h2-stripe h2-stripe-ai">
    {{#get "tags" filter="slug:ai" limit="1" include="count.posts"}}
      {{#if tags}}
        {{#foreach tags}}
          <div class="h2-container">
            <header class="h2-stripe-head">
              <div class="h2-stripe-head-text">
                <h2 class="h2-stripe-flag">{{name}}</h2>
                {{#if description}}
                  <p class="h2-stripe-tagline">{{description}}</p>
                {{/if}}
              </div>
              <a class="h2-stripe-seeall" href="{{url}}">See all &rarr;</a>
            </header>
          </div>
        {{/foreach}}
      {{/if}}
    {{/get}}
    <div class="h2-container">
      {{#get "posts" filter="tag:ai" limit="3" include="tags"}}
        {{#if posts}}
          <div class="h2-stripe-grid">
            {{#foreach posts}}
              <article class="h2-stripe-card">
                <h3 class="h2-stripe-card-title"><a href="{{url}}">{{title}}</a></h3>
                <div class="ds-meta">
                  <time class="ds-meta-item">{{date format="MM DD YY"}}</time>
                  <span class="ds-meta-item ds-meta-comments" aria-label="Comments">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <span class="ds-meta-comments-text">{{comment_count}}</span>
                  </span>
                </div>
                <p class="h2-stripe-card-excerpt">{{excerpt words="35"}}</p>
              </article>
            {{/foreach}}
          </div>
        {{else}}
          <p class="h2-stripe-empty">No posts yet.</p>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{!-- ============ Org Design stripe ============ --}}
  <section class="h2-section h2-stripe h2-stripe-orgdesign">
    {{#get "tags" filter="slug:org-design" limit="1" include="count.posts"}}
      {{#if tags}}
        {{#foreach tags}}
          <div class="h2-container">
            <header class="h2-stripe-head">
              <div class="h2-stripe-head-text">
                <h2 class="h2-stripe-flag">{{name}}</h2>
                {{#if description}}
                  <p class="h2-stripe-tagline">{{description}}</p>
                {{/if}}
              </div>
              <a class="h2-stripe-seeall" href="{{url}}">See all &rarr;</a>
            </header>
          </div>
        {{/foreach}}
      {{/if}}
    {{/get}}
    <div class="h2-container">
      {{#get "posts" filter="tag:org-design" limit="3" include="tags"}}
        {{#if posts}}
          <div class="h2-stripe-grid">
            {{#foreach posts}}
              <article class="h2-stripe-card">
                <h3 class="h2-stripe-card-title"><a href="{{url}}">{{title}}</a></h3>
                <div class="ds-meta">
                  <time class="ds-meta-item">{{date format="MM DD YY"}}</time>
                  <span class="ds-meta-item ds-meta-comments" aria-label="Comments">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <span class="ds-meta-comments-text">{{comment_count}}</span>
                  </span>
                </div>
                <p class="h2-stripe-card-excerpt">{{excerpt words="35"}}</p>
              </article>
            {{/foreach}}
          </div>
        {{else}}
          <p class="h2-stripe-empty">No posts yet.</p>
        {{/if}}
      {{/get}}
    </div>
  </section>

  {{!-- ============ Hidden Patterns module ============ --}}
  <section class="h2-section h2-book-section">
    <div class="h2-container h2-book">
      <div class="h2-book-cover-wrap">
        <img class="h2-book-cover"
             src="{{asset "images/hidden-patterns-cover.png"}}"
             alt="Hidden Patterns book cover"
             loading="lazy">
      </div>
      <div class="h2-book-copy">
        <p class="h2-flag h2-book-flag">The Book</p>
        <h2 class="h2-book-title">Hidden Patterns</h2>
        <p class="h2-book-deck">
          Most &ldquo;people problems&rdquo; are org design problems. This book shows you how to fix them for good.
        </p>
        <blockquote class="h2-book-pullquote">
          <p>&ldquo;Most management books offer theory; <em>Hidden Patterns</em> offers transformation. It empowers anyone to make practical, concrete changes that yield tangible results and elevate every dimension of work&mdash;from revenue and profit to meaning and satisfaction.&rdquo;</p>
          <cite class="h2-book-pullquote-cite">&mdash; Marissa Jarratt, CMO, 7-Eleven</cite>
        </blockquote>
        <div class="h2-book-actions">
          <a class="h2-btn h2-btn-primary" href="/buy/">Buy the book &rarr;</a>
          <a class="h2-btn h2-btn-text" href="/introduction/">Read a free chapter</a>
        </div>
        <p class="h2-book-inside">
          <span class="h2-book-inside-label">Inside:</span>
          <a href="/start-end/">Start &amp; End</a> &middot;
          <a href="/foundations/">Foundations</a> &middot;
          <a href="/structuring/">Structuring</a> &middot;
          <a href="/direction/">Direction</a> &middot;
          <a href="/practice/">Practice</a> &middot;
          <a href="/learning/">Learning</a> &middot;
          <a href="/space/">Space</a>
        </p>
      </div>
    </div>
  </section>

  {{!-- ============ Talks promo ============ --}}
  <section class="h2-talks" aria-labelledby="h2-talks-title">
    <div class="h2-talks-bg" aria-hidden="true">
      <img class="h2-talks-img"
           src="{{asset "images/talks-stage.jpg"}}"
           alt=""
           loading="lazy"
           width="2560"
           height="1708">
      <div class="h2-talks-overlay"></div>
    </div>
    <div class="h2-talks-inner">
      <p class="h2-flag h2-talks-flag">Speaking</p>
      <h2 class="h2-talks-title" id="h2-talks-title">Bring this thinking to your team.</h2>
      <p class="h2-talks-deck">Keynotes and workshops on organization design, AI, and the patterns that shape how work actually works.</p>
      <div class="h2-talks-actions">
        <a class="h2-btn h2-btn-primary h2-talks-cta" href="/talks/">See recent engagements &amp; book &rarr;</a>
      </div>
    </div>
  </section>

</main>
